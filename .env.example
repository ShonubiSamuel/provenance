# --- GitHub App auth (see docs/DATA_MODEL_AND_PIPELINE.md) ---
# Create a GitHub App, download its private key, install it, and fill these in.
GH_APP_ID=
GH_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
GH_APP_INSTALLATION_ID=

# Fallback for local dev only — a classic/fine-grained PAT. Leave blank in normal use.
# Never set multiple PATs to dodge rate limits (ToS violation).
GH_PAT=

# --- Storage ---
DATABASE_URL=sqlite:///./data/explorer.db

# --- Rate limiter (requests per minute per bucket) ---
# search is the system throughput ceiling — GitHub's `code_search` resource allows only
# 10 req/min authenticated (x-ratelimit-limit: 10); exceeding it triggers 429s and
# secondary abuse cooldowns that stall every collection. The search bucket also refuses
# to burst (one call every 60/RPM seconds), because GitHub punishes clumped calls with
# secondary limits — and with 200s that carry a match count and no results.
RATE_SEARCH_RPM=8
RATE_CORE_RPM=80
RATE_GRAPHQL_RPM=80

# --- Discovery limits ---
# Max GitHub search calls one discovery may spend before it stops and says so.
DISCOVERY_CALL_BUDGET=300
# Reported-match count above which a query is too broad to collect: we keep the first
# 1,000 results, mark the search `sampled`, and tell the user to narrow it. Raising this
# does not make GitHub faster — it only makes hopeless searches run longer.
DISCOVERY_SAMPLE_ABOVE=25000

# --- API server ---
API_HOST=127.0.0.1
API_PORT=8787

# --- Download manager (aria2) ---
DOWNLOAD_DIR=~/Data/datasets/unity-repo-corpus
ARIA2_RPC_PORT=6801
ARIA2_MAX_CONNECTIONS=8
DOWNLOADS_AUTOSTART=true
